# Neo4j credentials in USERNAME/PASSWORD format (used by the neo4j service).
# Use a long, random password for production.
NEO4J_AUTH=neo4j/CHANGE_ME_TO_A_STRONG_PASSWORD

# Plain-text password used by the UI and MCP server to connect via Bolt.
# Must match the password portion of NEO4J_AUTH.
NEO4J_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Neo4j JVM heap size and container memory limit.
NEO4J_HEAP_SIZE=1G
NEO4J_MEMORY_LIMIT=2G

# Host/port exposed on the Docker host for the Neo4j Browser (HTTP).
NEO4J_BROWSER_HOST=127.0.0.1
NEO4J_BROWSER_PORT=7474

# Host/port advertised for the Bolt connector (used by Neo4j Browser and external clients).
NEO4J_BOLT_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687

# Bolt URI exposed to the browser for the graph UI (use the host-accessible address, not the Docker service name).
NEO4J_UI_URI=bolt://localhost:7687

# MCP server limits.
MCP_MAX_RECORDS=100
MCP_QUERY_TIMEOUT_MS=30000

# Comma-separated list of allowed origins for the MCP CORS policy.
# Leave empty to disallow browser cross-origin requests.
MCP_ALLOWED_ORIGINS=

# Ports exposed on the Docker host.
UI_HOST=127.0.0.1
UI_PORT=3000
MCP_HOST=127.0.0.1
MCP_PUBLISHED_PORT=3001

# Ollama configuration for the natural-language-to-Cypher proxy.
# The model must be pulled before use, e.g.: ollama pull qwen2.5-coder:7b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_PROXY_PUBLISHED_PORT=3005
